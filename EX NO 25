#!/bin/bash
echo "Enter three numbers:"
read a b c
if [ $a -ge $b ] && [ $a -ge $c ]; then
    echo "$a is the biggest"
elif [ $b -ge $a ] && [ $b -ge $c ]; then
    echo "$b is the biggest"
else
    echo "$c is the biggest"
fi
